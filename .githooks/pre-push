#!/usr/bin/env bash
# Checks the formatting before a push, then runs gitleaks on the commits the push
# adds. git and GitButler (`but push`) both run it through core.hooksPath, which
# `mise run setup` sets; --no-verify skips it. The regression suite is too slow for
# every push: CONTRIBUTING.md says when to run it.
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

remote=$1
refs=0 tips=()
while read -r _ sha _ _; do
  refs=$((refs + 1))
  # An all-zero sha deletes the remote branch: nothing to scan.
  [[ $sha =~ ^0+$ ]] || tips+=("$sha")
done
# No ref lines (a tool that doesn't pass them): scan everything unpushed instead.
[ "$refs" -gt 0 ] || tips=(HEAD)

mise run -q check:fmt </dev/null
[ ${#tips[@]} -gt 0 ] || exit 0

# What the push adds: commits not yet on any of the remote's branches.
exec mise run -q check:secrets "${tips[@]}" --not --remotes="$remote" </dev/null
