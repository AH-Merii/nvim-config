#!/usr/bin/env bash
#MISE description="Run the regress suite in the test image as n shards in n containers at once (default 4); builds it first"
#MISE depends=["test:image:build"]
# usage: shards [n] [suite.sh selection args]
# Each shard is `_default suite --shard i/n` (its own container, capped at 2 GB, output in $NVR_OUT/suite-<i>), split
# by tests/regress/durations.tsv. After all finish, prints each shard's log, then checks with shard-cover.sh that the
# shards ran every selected check exactly once. CI runs this file with bash, after building the image itself.
set -uo pipefail
n=4
[[ ${1:-} =~ ^[1-9][0-9]*$ ]] && { n=$1; shift; }
base=${NVR_OUT:-tests/regress/last/image-shards}
here=$(dirname "${BASH_SOURCE[0]}")
rm -rf "$base" && mkdir -p "$base" || exit 2
t0=$EPOCHREALTIME
pids=()
for i in $(seq "$n"); do
  NVR_OUT=$base/suite-$i bash "$here/_default" suite --shard "$i/$n" "$@" >"$base/shard-$i.log" 2>&1 &
  pids+=($!)
done
rc=0 status=()
for i in $(seq "$n"); do
  if wait "${pids[$((i - 1))]}"; then status+=(pass); else status+=(FAIL); rc=1; fi
done
wall=$(awk -v a="$t0" -v b="$EPOCHREALTIME" 'BEGIN { printf "%.1f", b - a }')
for i in $(seq "$n"); do
  [ -n "${GITHUB_ACTIONS:-}" ] && echo "::group::shard $i/$n: ${status[$((i - 1))]}"
  [ -z "${GITHUB_ACTIONS:-}" ] && echo "== shard $i/$n: ${status[$((i - 1))]}"
  cat "$base/shard-$i.log"
  [ -n "${GITHUB_ACTIONS:-}" ] && echo "::endgroup::"
done
echo
echo "== shards"
for i in $(seq "$n"); do
  echo "shard $i/$n: ${status[$((i - 1))]}, $(grep -m1 '^total: ' "$base/shard-$i.log" || echo 'no total')"
  grep -E '^FAIL ' "$base/shard-$i.log" | sed 's/^/  /'
done
echo "all shards: ${wall}s"
files=()
for i in $(seq "$n"); do files+=("$base/suite-$i/results.tsv"); done
"$here/../../../tests/regress/shard-cover.sh" --results "$n" "${files[@]}" -- "$@" || rc=1
exit $rc
